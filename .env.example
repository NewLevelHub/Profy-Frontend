# Base URL for all API requests.
# Dev: use /api/v1 so Vite proxy forwards /api/* to the local backend.
# Prod: full URL of the Profy backend.
VITE_API_URL=/api/v1

# Application display name
VITE_APP_NAME=Profy

# Куда ведёт логотип с экранов входа.
# Dev: лендинг лежит в public/landing/. Prod: обычно просто /
VITE_LANDING_URL=/landing/index.html
