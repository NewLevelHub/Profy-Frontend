# Base URL for all API requests.
# Dev: use /api/v1 so Vite proxy forwards /api/* to the local backend.
# Prod: full URL of the Profy backend.
VITE_API_URL=/api/v1

# Application display name
VITE_APP_NAME=Profy

# Google OAuth 2.0 Web Client ID (Google Identity Services, ID-token flow).
# Public identifier, safe to expose in frontend code. Create it in Google
# Cloud Console as an OAuth 2.0 Client ID of type "Web application" and add
# this app's origins under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
